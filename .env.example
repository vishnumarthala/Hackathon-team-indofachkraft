# Copy to .env.local (never commit it).
# Local Docker: `npm run db:env` fills the 4 Supabase values. Supabase cloud: copy them from the dashboard,
# then run `npm run db:push` once to apply supabase/migrations to the cloud database.
# Newer Supabase projects name the keys NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY and SUPABASE_SECRET_KEY; both names work.

# Base URL used in email links and WhatsApp text
NEXT_PUBLIC_APP_URL=http://localhost:3000
# true = answer Scribe, Gemini, ElevenLabs and Resend from demo/fixtures (no credits spent)
DEMO_MODE=true
# Local Supabase API URL (server and browser upload)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Local Supabase anon key (browser authentication and signed uploads; RLS blocks clinical table reads)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Local Supabase service role key (server only, never sent to the browser)
SUPABASE_SERVICE_ROLE_KEY=
# Postgres URL for db:sql, db:check and seed scripts (local Supabase default)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Google OAuth client for guardian sign-in on LOCAL Supabase only (read by the Supabase CLI, not the app;
# see docs/guardian-auth.md). Hosted Supabase: set Google in the dashboard instead. Leave empty to keep it off.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
# ElevenLabs API key (Scribe, conversation token, TTS)
ELEVENLABS_API_KEY=
# ElevenLabs intake agent id (see docs/elevenlabs-agent.md)
ELEVENLABS_AGENT_ID=
# ElevenLabs post-call webhook HMAC secret (only when deployed or tunnelled)
ELEVENLABS_WEBHOOK_SECRET=
# ElevenLabs English voice id for the parent voice note
ELEVENLABS_VOICE_ID_EN=
# ElevenLabs Hindi voice id for the parent voice note
ELEVENLABS_VOICE_ID_HI=
# ElevenLabs Telugu voice id for the parent voice note
ELEVENLABS_VOICE_ID_TE=
# Google AI Studio Gemini API key
GEMINI_API_KEY=
# Gemini model id
GEMINI_MODEL=gemini-3.8-flash
# Show demo (synthetic) provider profiles in the public directory with a "Demo profile" badge (default true)
SHOW_SYNTHETIC_LISTINGS=true
# Google Maps (ticket 029, see docs/maps.md). All optional: without keys geocoding uses the bundled Hyderabad
# locality/PIN code table and /find shows the list without a map.
# Server key: Geocoding API only, restricted by API + server IP. Never NEXT_PUBLIC_, never sent to the browser.
GOOGLE_MAPS_SERVER_KEY=
# Browser key: Maps JavaScript API, Places API (New), Maps Static API only, restricted by HTTP referrer
# (your domains + http://localhost:3000/*). Public by design.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
# Optional Google Cloud map id for vector maps/advanced markers (default: Google's DEMO_MAP_ID)
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
# Resend API key
RESEND_API_KEY=
# Sender address (Resend test sender)
EMAIL_FROM="DoctorNearMe <onboarding@resend.dev>"
# If set, every email goes to this address instead (Resend test sender only delivers to the account owner)
DEMO_EMAIL_TO=
# Secret salt for the hashed IP stored with each consent record (ticket 020). Optional: falls back to the
# service role key. Changing it only affects new records.
CONSENT_IP_SALT=
# Notifications (ticket 032, see docs/notifications.md).
# Shared secret for /api/cron/* (Vercel cron sends `Authorization: Bearer <CRON_SECRET>`). Unset = cron refused.
CRON_SECRET=
# Meta WhatsApp Cloud API (permanent system-user token + the sender's phone number id). Optional: without both
# (or with DEMO_MODE=true) WhatsApp notifications are skipped with `whatsapp_not_configured`.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Graph API version for WhatsApp (default v21.0)
WHATSAPP_API_VERSION=v21.0
