# Copy to .env.local (never commit it).
# Local Docker: `npm run db:env` fills the 4 Supabase values. Supabase cloud: copy them from the dashboard,
# then run `npm run db:push` once to apply supabase/migrations to the cloud database.
# Newer Supabase projects name the keys NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY and SUPABASE_SECRET_KEY; both names work.

# Base URL used in email links and WhatsApp text
NEXT_PUBLIC_APP_URL=http://localhost:3000
# true = answer Scribe, Gemini, ElevenLabs and Resend from demo/fixtures (no credits spent)
DEMO_MODE=true
# Local Supabase API URL (server and browser upload)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Local Supabase anon key (browser authentication and signed uploads; RLS blocks clinical table reads)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Local Supabase service role key (server only, never sent to the browser)
SUPABASE_SERVICE_ROLE_KEY=
# Postgres URL for db:sql, db:check and seed scripts (local Supabase default)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# ElevenLabs API key (Scribe, conversation token, TTS)
ELEVENLABS_API_KEY=
# ElevenLabs intake agent id (see docs/elevenlabs-agent.md)
ELEVENLABS_AGENT_ID=
# ElevenLabs post-call webhook HMAC secret (only when deployed or tunnelled)
ELEVENLABS_WEBHOOK_SECRET=
# ElevenLabs English voice id for the parent voice note
ELEVENLABS_VOICE_ID_EN=
# ElevenLabs Hindi voice id for the parent voice note
ELEVENLABS_VOICE_ID_HI=
# ElevenLabs Telugu voice id for the parent voice note
ELEVENLABS_VOICE_ID_TE=
# Google AI Studio Gemini API key
GEMINI_API_KEY=
# Gemini model id
GEMINI_MODEL=gemini-3.8-flash
# Resend API key
RESEND_API_KEY=
# Sender address (Resend test sender)
EMAIL_FROM="DoctorNearMe <onboarding@resend.dev>"
# If set, every email goes to this address instead (Resend test sender only delivers to the account owner)
DEMO_EMAIL_TO=
