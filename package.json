{
  "name": "carethread",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build",
    "prepare": "node scripts/dev/install-hooks.mjs",
    "db:migrate": "supabase migration up --local",
    "db:reset": "supabase db reset",
    "db:env": "node scripts/env-from-supabase.mjs",
    "db:check": "tsx scripts/db-check.ts",
    "db:sql": "tsx scripts/sql.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "fixtures:scribe": "tsx scripts/make-scribe-fixture.ts"
  },
  "dependencies": {
    "@elevenlabs/elevenlabs-js": "^2.77.0",
    "@elevenlabs/react": "^1.21.1",
    "@google/genai": "^3.0.0",
    "@next/env": "^16.4.5",
    "@supabase/supabase-js": "^2.119.0",
    "next": "16.4.5",
    "postgres": "^4.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.37.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "supabase": "^3.0.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=20"
  }
}
